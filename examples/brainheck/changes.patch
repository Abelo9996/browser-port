+/* Read the whole of a stream into a NUL-terminated buffer. */
+static char *read_all(FILE *file) {
+    size_t cap = 1 << 16;
+    size_t len = 0;
+    char *buf = malloc(cap);
+    if (!buf) return NULL;
+    int ch;
+    while ((ch = getc(file)) != EOF) {
+        if (len + 1 >= cap) {
+            cap *= 2;
+            char *grown = realloc(buf, cap);
+            if (!grown) { free(buf); return NULL; }
+            buf = grown;
+        }
+        buf[len++] = (char)ch;
+    }
+    buf[len] = '\0';
+    return buf;
+}
